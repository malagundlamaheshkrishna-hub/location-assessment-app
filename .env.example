# =================================================================
# Location Assessment Application - Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# =================================================================

# Backend Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./locations.db

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Third-party / External API Keys (Placeholders)
# US Census Geocoder, USGS EPQS, and Open-Meteo do not require API keys.
# Add any future or alternative provider keys below:
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
